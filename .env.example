# TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather on Telegram.
# Configure this in the Secrets panel in AI Studio or Cloud Run environment variables.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# WEBHOOK_SECRET: Secret token to validate X-Telegram-Bot-Api-Secret-Token header.
# Ensures all incoming webhook requests genuinely originate from Telegram.
WEBHOOK_SECRET="MY_WEBHOOK_SECRET"

# ADMIN_TELEGRAM_ID: Numeric Telegram ID for the super administrator.
# Only this user can unlock the private /admin control panel in Telegram.
ADMIN_TELEGRAM_ID="684920153"

# APP_URL: The URL where this applet is hosted on Google Cloud Run.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

