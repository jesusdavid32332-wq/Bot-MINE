# Puerto del servidor (Vercel lo gestiona automáticamente)
PORT=3000

# Cadena de conexión de Neon PostgreSQL (Requerida para Neon)
# Formato: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Token del bot entregado por @BotFather en Telegram
# Formato: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=

# Token secreto para validar cabecera x-telegram-bot-api-secret-token de Telegram
WEBHOOK_SECRET=jc_mines_webhook_secret_9981

# Tu ID numérico personal de Telegram para desbloquear /admin
ADMIN_TELEGRAM_ID=684920153

# URL pública de tu servicio desplegado en Vercel (ej. https://mi-bot-mines.vercel.app)
PUBLIC_BASE_URL=

# Variables alternativas compatibles:
# POSTGRES_URL=
# NEON_DATABASE_URL=
# BOT_TOKEN=
# ADMIN_TELEGRAM=
# VERCEL_URL=