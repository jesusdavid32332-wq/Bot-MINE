rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users collection: Telegram bot users & registration statuses
    match /users/{userId} {
      allow get, write: if isValidId(userId);
      allow list: if true;
    }

    // Messages collection: Sequenced message templates
    match /messages/{messageId} {
      allow get, write: if isValidId(messageId);
      allow list: if true;
    }

    // Conversations collection: Chat histories
    match /conversations/{userId} {
      allow get, write: if isValidId(userId);
      allow list: if true;
      match /messages/{msgId} {
        allow get, write: if isValidId(msgId);
        allow list: if true;
      }
    }

    // Flows collection: Step configuration nodes
    match /flows/{flowId} {
      allow get, write: if isValidId(flowId);
      allow list: if true;
    }

    // Conditions collection: Keyword dictionaries
    match /conditions/{conditionId} {
      allow get, write: if isValidId(conditionId);
      allow list: if true;
    }

    // Media collection: Photos and videos
    match /media/{mediaId} {
      allow get, write: if isValidId(mediaId);
      allow list: if true;
    }

    // Settings collection: Bot config and general config
    match /settings/{settingId} {
      allow get, write: if isValidId(settingId);
      allow list: if true;
    }

    // Processed updates collection: Telegram update_id deduplication
    match /processed_updates/{updateId} {
      allow get, write: if isValidId(updateId);
      allow list: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
